ACTION_PHP_EACH acm_files AS index => file BEGIN
  COPY ~%file%~ ~%file%~
    READ_SHORT 10 rate
    PATCH_IF (rate = 22050) BEGIN
      WRITE_SHORT 10 44100
    END
  BUT_ONLY_IF_IT_CHANGES
END
